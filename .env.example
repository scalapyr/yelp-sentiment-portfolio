# Copy to .env and fill in. Used only by the pipeline scripts in pipeline/
# (the dashboard needs no secrets). Never commit the real .env.

# Gemini (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# Snowflake
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=your-role
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=YELP_DB
SNOWFLAKE_SCHEMA=RAW

# Local paths to the Yelp Open Dataset files (not included in this repo)
BUSINESS_JSON_PATH=/path/to/yelp_academic_dataset_business.json
REVIEW_JSON_PATH=/path/to/yelp_academic_dataset_review.json

# Batch request file produced by pipeline/enrichment/prepare_batch.py
BATCH_INPUT_FILE=yelp_batch_input.jsonl
